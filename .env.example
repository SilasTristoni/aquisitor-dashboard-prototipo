# Copie para .env e troque todos os valores antes de expor o sistema em rede.
POSTGRES_PASSWORD=troque-por-uma-senha-forte
THERMOPOWER_JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes
THERMOPOWER_DEMO_ADMIN_PASSWORD=troque-a-senha-inicial

# Execução local sem Docker (prefixo THERMOPOWER_ lido pelo backend)
THERMOPOWER_DATABASE_URL=sqlite:///./thermopower.db
THERMOPOWER_CORS_ORIGINS=["http://localhost:5173"]
THERMOPOWER_MAX_UPLOAD_BYTES=26214400
THERMOPOWER_MAX_REPORT_PERIOD_DAYS=366
THERMOPOWER_REPORT_PREVIEW_MAX_POINTS=2500
THERMOPOWER_REPORT_ENERGY_MAX_GAP_SECONDS=60
THERMOPOWER_REPORT_OUTPUT_DIRECTORY=./reports
